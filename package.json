{
  "name": "ai-home-modeler",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ai-home-modeler/web",
    "build": "npm run build --workspace @ai-home-modeler/web",
    "lint": "npm run lint --workspace @ai-home-modeler/web",
    "typecheck": "npm run typecheck --workspace @ai-home-modeler/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:lint": "prettier --check \"**/*.md\""
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
