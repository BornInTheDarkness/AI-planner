    "\u0427\u0435\u0440\u0442\u0451\u0436\u043d\u044b\u0439 \u0441\u0435\u0440\u0432\u0438\u0441 \u0441\u0447\u0438\u0442\u0430\u043b\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u0438\u0437\u0443\u0430\u043b\u044c\u043d\u044b\u043c \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u043e\u043c.md",
    "\u042d\u043a\u0441\u043f\u0435\u0440\u0442\u043d\u0430\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0441\u0442\u0435\u043d, \u043c\u043e\u043a\u0440\u044b\u0445 \u0437\u043e\u043d \u0438 \u0438\u043d\u0436\u0435\u043d\u0435\u0440\u0438\u0438.md",
    "\u042d\u0442\u0430\u043f 0 \u0432\u044b\u0445\u043e\u0434\u043d\u043e\u0439 gate.md"
  ]
